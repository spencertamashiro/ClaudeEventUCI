  "issues": [
    {
      "id": "ring-mall",
      "title": "Ring Mall hours and device scope",
      "detail": "UCI housing lists weekday bicycle hours. Transportation summaries give the same clock times with broader wording and no weekday qualifier. Confirm controlling policy, signs, facility boundaries and each device profile.",
      "status": "conflict",
      "sourceIds": [
        "uci-housing",
        "uci-safety",
        "uci-pathways",
        "uci-policy"
      ]
    },
    {
      "id": "campus-speed",
      "title": "Campus and housing speed coverage",
      "detail": "UCI publishes an 8 mph reference. Match the stated area, facility and device scope to surveyed segments, including adjacent student housing, before assigning any ceiling.",
      "status": "review",
      "sourceIds": [
        "uci-housing",
        "uci-pathways",
        "uci-map"
      ]
    },
    {
      "id": "scooter-ceiling",
      "title": "Electric scooter statute and applicability",
      "detail": "Irvine Police reports a 15 mph maximum and sidewalk restriction. The official statute text was inaccessible at review time. Check current statutory text, exceptions and segment jurisdiction.",
      "status": "review",
      "sourceIds": [
        "irvine-ipd",
        "ca-scooter-speed"
      ]
    },
    {
      "id": "class3",
      "title": "Class 3 access on connecting bikeways",
      "detail": "Separate City and county facilities, identify ownership by segment, and confirm enacted language and effective dates. The older City handout, 2026 staff draft, and OC Parks guidance have different scopes.",
      "status": "review",
      "sourceIds": [
        "irvine-paths",
        "irvine-draft",
        "oc-parks"
      ]
    },
    {
      "id": "utc",
      "title": "University Town Center connections and parking",
      "detail": "Confirm property boundaries, signed device rules, bridge approaches and rack locations. A reference map alone does not establish access or geometry reuse.",
      "status": "missing",
      "sourceIds": [
        "uci-map",
        "uci-projects"
      ]
    },
    {
      "id": "geometry-license",
      "title": "Reusable bikeway and policy geometry",
      "detail": "Irvine publishes a City Bikeways query layer. The layer metadata does not establish redistribution rights and the City website policy includes limits. Confirm dataset terms and survey endpoints before importing overlays.",
      "status": "missing",
      "sourceIds": [
        "irvine-gis",
        "irvine-terms"
      ]
    },
    {
      "id": "closure-feed",
      "title": "Current closures and temporary restrictions",
      "detail": "Confirm authoritative current closure data and effective intervals. A project list is insufficient for determining whether a segment is open.",
      "status": "missing",
      "sourceIds": [
        "uci-projects",
        "irvine-gis"
      ]
    },
    {
      "id": "basemap",
      "title": "Attribution and basemap scope",
      "detail": "OpenFreeMap and OpenStreetMap provide geographic context. Their display does not verify device access, closures or riding speed.",
      "status": "review",
      "sourceIds": [
        "openfreemap",
        "osm"
      ]
    },
    {
      "id": "city-path-speed",
      "title": "Irvine bicycle-path speed applicability",
      "detail": "Signed minutes record the adoption of Ordinance 26-05. The adoption packet sets a 20 mph bicycle and e-bike ceiling on bicycle paths and trails, with a reasonable-speed condition and effect 30 days after adoption. Check current codification, geographic jurisdiction and facility classification before attaching it to any segment.",
      "status": "review",
      "sourceIds": [
        "irvine-26-05-packet",
        "irvine-26-05-minutes",
        "irvine-code"
      ]
    }
